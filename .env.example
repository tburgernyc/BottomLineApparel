# ═══════════════════════════════════════════════
# Bottom Line Apparel — Environment Variables
# Copy this file to .env.local for local dev
# Set these in Vercel Dashboard → Settings → Environment Variables
# ═══════════════════════════════════════════════

# ── Printful API (required for product catalog + fulfillment) ──
# Get your API key from: https://www.printful.com/dashboard/store/api-key
PRINTFUL_API_KEY=your_printful_api_key_here

# Your Printful store ID (found in the Printful dashboard URL)
PRINTFUL_STORE_ID=your_printful_store_id_here

# When set to "true", Printful orders are auto-confirmed on creation.
# Keep "false" while testing; flip to "true" once a successful test order ships.
PRINTFUL_AUTO_CONFIRM=false

# ── Stripe (required for checkout) ──
# Get your Secret Key from: https://dashboard.stripe.com/apikeys
# Use sk_test_… in test mode and sk_live_… for production.
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here

# Webhook signing secret for /api/stripe-webhook
# Create the webhook endpoint at https://dashboard.stripe.com/webhooks
# pointing at https://<your-domain>/api/stripe-webhook
# subscribed to event: checkout.session.completed
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret_here

# ── Klaviyo (optional — for email list capture) ──
# Private API key from: https://www.klaviyo.com/account#api-keys-tab
# If not set, /api/subscribe will log signups to console only
KLAVIYO_PRIVATE_KEY=your_klaviyo_private_key_here

# Your Klaviyo List ID (the list subscribers are added to)
# Find in: Klaviyo → Audience → Lists → click list → URL contains the ID
KLAVIYO_LIST_ID=your_klaviyo_list_id_here

# ── Mailchimp (alternative to Klaviyo — optional) ──
# Uncomment and fill in if you prefer Mailchimp over Klaviyo
# Also uncomment the Mailchimp block in api/subscribe.js
# MAILCHIMP_API_KEY=your_mailchimp_api_key_here
# MAILCHIMP_LIST_ID=your_mailchimp_audience_id_here
# MAILCHIMP_SERVER=us1

# ── Resend (required for order confirmation + admin failure alerts) ──
# Sign up at https://resend.com (free tier = 3k emails/month)
# Verify bottomlineapparel.store as sending domain (SPF/DKIM/DMARC records)
# then create an API key at https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key_here

# From-address on customer + admin emails. Must be on a verified Resend domain.
# The verified domain is info.bottomlineapparel.store (subdomain), not the root.
RESEND_FROM_EMAIL=orders@info.bottomlineapparel.store

# Where admin failure alerts are sent (Printful order creation fails after charge, etc.)
ADMIN_ALERT_EMAIL=t.burgernyc@gmail.com

# ── Vercel KV (required for order log + post-payment recovery) ──
# Provision via: Vercel Dashboard → Storage → Create Database → KV
# These four vars are auto-injected by Vercel when KV is connected to the project.
# Listed here for reference only — do NOT paste values into .env.local manually
# unless you're running against the Vercel KV REST API from local dev.
KV_URL=
KV_REST_API_URL=
KV_REST_API_TOKEN=
KV_REST_API_READ_ONLY_TOKEN=
